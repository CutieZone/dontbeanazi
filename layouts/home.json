{{- $items := slice -}}
{{- range first 10 (where .Site.RegularPages "Type" "!=" "pages") -}}
  {{- $items = $items | append (dict "id" .Permalink "title" .Title "url" .Permalink "date_published" (.Date.Format "2006-01-02T15:04:05Z07:00")) -}}
{{- end -}}
{
  "version": "https://jsonfeed.org/version/1.1",
  "title": {{ .Site.Title | jsonify }},
  "description": {{ .Site.Params.description | jsonify }},
  "home_page_url": {{ .Site.BaseURL | jsonify }},
  "feed_url": {{ .Permalink | jsonify }},
  "items": {{ $items | jsonify }}
}
